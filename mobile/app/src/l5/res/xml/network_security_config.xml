<!-- The test app (l5) may reach a server on the computer in clear text,
     through adb reverse; everything else as Android's default. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
