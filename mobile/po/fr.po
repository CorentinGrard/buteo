#. welcome_no_glider
msgid "Without one, Buteo shows \"NO POLAR\" and leaves final glide out; %1$s adds one later."
msgstr "Sans polaire, Buteo affiche \"PAS DE POLAIRE\" et n'indique pas la finale ; %1$s permet d'en ajouter une plus tard."

